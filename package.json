{
  "name": "jev-slide-score",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Slide Score: a two-board duel on 2048 rules against Jev with matched spawns, verified leaderboards and replay analytics",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env server/local.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "bench": "node --env-file-if-exists=.env bench/run.js",
    "verify": "node scripts/verify.js",
    "export": "node scripts/export.js",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.js",
    "deploy:godaddy": "node --env-file-if-exists=.env scripts/godaddy-deploy.js",
    "secrets": "node scripts/secrets.js",
    "fingerprint": "node scripts/fingerprint.js",
    "maintenance": "node scripts/maintenance.js"
  }
}
