# Copy to .env for local execution. Never commit this file with actual credentials.
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
# Optional comma-separated old origins this server still answers on (production: https://2048.jevplay.games).
# Each entry must be a bare https origin (scheme, host, optional port, at most one trailing slash; http only for loopback).
# Entries with credentials, a path, a query, a fragment or any of @ ? # * are ignored with a structured warning.
# LEGACY_PUBLIC_ORIGINS=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=10000
JEV_REQUESTS_PER_DAY=10000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Comma-separated approved guild:channel pairs (ordinary server text channels).
DISCORD_ALLOWED_CHANNELS=
# Optional local overrides; generated private keys persist automatically in .data.
# Public hosting requires explicit 64-hex-character keys generated with npm run secrets.
# APP_SIGNING_KEY=
# SEED_ENCRYPTION_KEY=
# ADMIN_API_KEY=
# GoDaddy Node.js Hosting deploys (npm run deploy:godaddy; CI uses the GODADDY_PAT repository secret).
GODADDY_APP_ID=cthdfczuwe
GODADDY_PAT=
