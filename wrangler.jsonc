  "vars": {"PUBLIC_ORIGIN": "https://2048.jevplay.games", "JEV_MODEL": "jev-1.13.0", "JEV_REQUESTS_PER_DAY": "10000", "DISCORD_ALLOWED_CHANNELS": ""}
